{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://amazebid-api.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_ADMIN_EMAIL": "Nhatlinhckm2016@gmail.com",
    "VITE_API_URL": "https://api.amazebid.co",
    "ADMIN_PASSWORD": "admin123"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://amazebid-api.onrender.com/api/:path*"
    }
  ]
}
